#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
bundled_node_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin"
bundled_bin_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/bin/fallback"
if [[ -x "$bundled_node_dir/node" ]]; then
  export PATH="$bundled_node_dir:$bundled_bin_dir:$PATH"
elif [[ -x /usr/local/opt/node/bin/node ]]; then
  export PATH="/usr/local/opt/node/bin:$PATH"
fi

node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)"
if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
  echo "Gmail Switchboard needs Node 22 or newer." >&2
  echo "Install a current Node release, then rerun ./setup." >&2
  exit 1
fi

if ! command -v pnpm >/dev/null 2>&1 || ! pnpm --version >/dev/null 2>&1; then
  corepack enable
  corepack prepare pnpm@11.9.0 --activate
fi

cd "$repo_dir"
pnpm install --frozen-lockfile
pnpm build
exec node "$repo_dir/scripts/setup.mjs" "$@"
