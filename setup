#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
codex_app_dir="/Applications/ChatGPT.app/Contents/Resources"
if ! command -v codex >/dev/null 2>&1 && [[ -x "$codex_app_dir/codex" ]]; then
  export PATH="$codex_app_dir:$PATH"
fi

bundled_node_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin"
bundled_bin_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/bin/fallback"
node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)"
if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
  if [[ -x "$bundled_node_dir/node" ]]; then
    export PATH="$bundled_node_dir:$bundled_bin_dir:$PATH"
  elif [[ -x /usr/local/opt/node/bin/node ]]; then
    export PATH="/usr/local/opt/node/bin:$PATH"
  fi
  node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)"
fi

if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
  echo "Mailroom needs Node 22 or newer." >&2
  echo "Install a current Node release, then rerun ./setup." >&2
  exit 1
fi

fast_command=false
if [[ "$#" -eq 1 && ( "$1" = "--doctor" || "$1" = "--uninstall" ) ]]; then
  fast_command=true
fi

build_current=false
cli_bundle="$repo_dir/plugins/mailroom/dist/cli.js"
server_bundle="$repo_dir/plugins/mailroom/dist/server.js"
keychain_helper="$repo_dir/plugins/mailroom/dist/keychain-helper"
helper_current=true
if [[ "$(uname -s)" = "Darwin" && ! -x "$keychain_helper" ]]; then
  helper_current=false
fi
if [[ -f "$cli_bundle" && -f "$server_bundle" && "$helper_current" = true ]]; then
  newer_source="$(find \
    "$repo_dir/plugins/mailroom/src" \
    "$repo_dir/plugins/mailroom/package.json" \
    "$repo_dir/plugins/mailroom/esbuild.config.mjs" \
    "$repo_dir/pnpm-lock.yaml" \
    -newer "$cli_bundle" -print -quit)"
  if [[ -z "$newer_source" ]]; then
    build_current=true
  fi
fi

if [[ "$fast_command" = true \
  && "$build_current" = true \
  && "${MAILROOM_SETUP_FORCE_BOOTSTRAP:-0}" != "1" ]]; then
  exec node "$repo_dir/scripts/setup.mjs" "$@"
fi

pnpm_command=()
if command -v pnpm >/dev/null 2>&1 && pnpm --version >/dev/null 2>&1; then
  pnpm_command=(pnpm)
elif command -v corepack >/dev/null 2>&1 \
  && corepack pnpm@11.9.0 --version >/dev/null 2>&1; then
  pnpm_command=(corepack pnpm@11.9.0)
elif command -v npx >/dev/null 2>&1; then
  pnpm_command=(npx --yes pnpm@11.9.0)
else
  echo "Mailroom could not find pnpm, Corepack, or npx." >&2
  echo "Install Node 22 or newer with npm, then rerun ./setup." >&2
  exit 1
fi

cd "$repo_dir"
echo "[1/2] Preparing Mailroom…"
"${pnpm_command[@]}" install --frozen-lockfile
echo "[2/2] Building Mailroom…"
"${pnpm_command[@]}" build
exec node "$repo_dir/scripts/setup.mjs" "$@"
