{
  "name": "@mailroom/mcp",
  "version": "0.4.0",
  "description": "Local multi-account Gmail MCP for Codex, Claude Code, and Cursor.",
  "license": "MIT",
  "private": true,
  "homepage": "https://mailroom.jacobkieser.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacbK/mailroom.git",
    "directory": "plugins/mailroom"
  },
  "bugs": {
    "url": "https://github.com/JacbK/mailroom/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mailroom": "dist/cli.js",
    "mailroom-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src test esbuild.config.mjs",
    "test": "node esbuild.config.mjs && vitest run",
    "test:coverage": "node esbuild.config.mjs && vitest run --coverage",
    "test:e2e:live": "node esbuild.config.mjs && node scripts/live-e2e.mjs"
  },
  "dependencies": {
    "@googleapis/gmail": "17.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "google-auth-library": "10.5.0",
    "html-to-text": "10.0.0",
    "mailparser": "3.9.15",
    "marked": "18.0.9",
    "nodemailer": "9.0.5",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
