{
  "mcpServers": {
    "mailroom": {
      "command": "node",
      "args": [
        "--input-type=module",
        "--eval",
        "const {pathToFileURL}=await import('node:url');const root=process.env.CLAUDE_PLUGIN_ROOT||process.cwd();await import(pathToFileURL(root+'/dist/server.js').href)"
      ],
      "cwd": "."
    }
  }
}
