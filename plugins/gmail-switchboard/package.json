{
  "name": "@gmail-switchboard/mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gmail-switchboard": "dist/cli.js",
    "gmail-switchboard-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
