    "html-to-text": "10.0.0",
    "mailparser": "3.9.14",
    "marked": "18.0.6",
    "nodemailer": "9.0.3",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
