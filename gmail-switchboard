#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$0")" && pwd)"
bundled_node_dir="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin"
if [[ -x "$bundled_node_dir/node" ]]; then
  export PATH="$bundled_node_dir:$PATH"
elif [[ -x /usr/local/opt/node/bin/node ]]; then
  export PATH="/usr/local/opt/node/bin:$PATH"
fi

if [[ ! -f "$repo_dir/plugins/gmail-switchboard/dist/cli.js" ]]; then
  echo "Gmail Switchboard is not built yet. Run ./setup first." >&2
  exit 1
fi

exec node "$repo_dir/plugins/gmail-switchboard/dist/cli.js" "$@"
